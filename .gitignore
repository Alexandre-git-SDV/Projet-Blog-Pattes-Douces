# Le code de l'application a son propre .gitignore dans blog-pattes-douces/.
# Celui-ci protege la racine du depot.

# env files : secrets, jamais commites (seul .env.example est versionne)
.env
.env.*
!.env.example

# dependances installees par erreur a la racine
node_modules/

# OS / editeurs
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
