# Base MongoDB utilisee par Prisma.
# Exemple local  : mongodb://localhost:27017/pattes-douces
# Exemple Atlas  : mongodb+srv://<user>:<password>@<cluster>/pattes-douces?retryWrites=true&w=majority
DATABASE_URL=

# Jeton Vercel Blob, utilise par POST /api/uploads pour stocker les images d'article.
# Se recupere dans le dashboard Vercel : Storage > Blob > Tokens.
BLOB_READ_WRITE_TOKEN=
